# 分销子站环境变量 —— 复制为 .env.sub 后填值
# 启动： docker compose -f docker-compose.sub.yml --env-file .env.sub up --build -d
#
# 安全要点：
#   - SESSION_SECRET / CRYPTO_SECRET 必须与主站【不同】（子站用户体系独立，不共享会话）
#   - POSTGRES / REDIS 密码独立设置
#   - LOCK_CHANNEL_TO_ROOT 已在 compose 里写死为 true，无需在此设置
#   - 子站监听宿主机端口 6000（主站 3000）

# ===== 子站数据库（独立容器 postgres-sub）=====
POSTGRES_USER=root
POSTGRES_PASSWORD=换成子站独立的强密码
POSTGRES_DB=new-api-sub

# ===== 子站 Redis（独立容器 redis-sub）=====
REDIS_PASSWORD=换成子站独立的强密码

# ===== 子站安全密钥（务必与主站不同，可用 openssl rand -hex 32 生成）=====
SESSION_SECRET=换成与主站不同的随机串
CRYPTO_SECRET=换成与主站不同的随机串

# ===== 对象存储（可选）=====
# 子站若不需要自己存图，全部留空即可；生图结果走主站返回的直链。
# 若要子站独立落地存储，再填以下项（可与主站同一套 R2，也可另开 bucket）。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
